+// patch-package: the upstream module declares its own `buildscript` block
+// pinning `com.android.tools.build:gradle:8.7.2` and a Kotlin plugin version.
+// Expo's `expo-root-project` already puts AGP and the Kotlin plugin on the
+// root buildscript classpath (which subprojects inherit), so the block only
+// forces a second, hard-pinned Android Gradle Plugin to be resolved — and
+// under this project's repository setup it does not resolve at all, failing
+// configuration of `:adivery` before anything can be built. Dropped so the
+// module uses the same toolchain as every other autolinked library.
 apply plugin: 'com.android.library'
 apply plugin: 'kotlin-android'
 
